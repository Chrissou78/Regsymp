{#
  The 33 — upcoming highlights, on the homepage.

  Built from the events table, so adding a date is adding a row rather than
  editing a template. Renders nothing at all when there is nothing to
  announce: a heading over an empty list reads as something having gone wrong.

  The words run down the left and the places down the right, each photograph
  feathering into the navy along a diagonal edge so the right-hand side reads
  as one continuous strip. That is the point of the arrangement: a list of six
  lines says "six dates"; this says "one series, six places".

  The page for it is /next/, which has the cards and the form. Here each row
  is simply a way in.
#}
{# `events` is generated before each build; guard it so a checkout that has
   never run the server still builds. #}
{# The 33's own editions. Napa and Mallorca belong to the Ninety-Nine and
   announce themselves in the hero, so this filters by series rather than
   showing everything that is upcoming. #}
{% set editions = events.bySeries["the-33"] if events and events.bySeries else [] %}
{% if editions and editions.length %}
<section class="upcoming" id="the-33" aria-labelledby="upcoming-title">
  <div class="upcoming-spread">
    <header class="upcoming-head">
      <p class="eyebrow">{{ upcomingCopy.eyebrow }}</p>
      <h2 class="h2" id="upcoming-title">{{ upcomingCopy.heading }}</h2>
    </header>

    <ol class="upcoming-strip">
      {% for event in editions %}
      {% set place = event.city or event.name %}
      <li>
        <a class="upcoming-row reveal" href="/next/#{{ event.slug }}">
          <div class="upcoming-entry">
            <p class="upcoming-where">
              <span class="upcoming-place">{{ place }}</span>
              <span class="upcoming-sep" aria-hidden="true">·</span>
              <span class="upcoming-when">{{ event.whenLabel }}</span>
            </p>
            {% if event.tagline %}<p class="upcoming-what">{{ event.tagline }}</p>{% endif %}
          </div>

          <div class="upcoming-shot">
            {# The wide crop, not the square the cards use: this row is a
               letterbox and a square cropped into it loses the subject. #}
            {% if event.wideImagePath %}
            <img src="/assets/images/{{ event.wideImagePath }}" alt="{{ event.imageAlt or place }}"
                 width="2400" height="900" loading="lazy" decoding="async">
            {% elif event.imagePath %}
            <img src="/assets/images/{{ event.imagePath }}" alt="{{ event.imageAlt or place }}"
                 width="800" height="800" loading="lazy" decoding="async">
            {% endif %}
          </div>
        </a>
      </li>
      {% endfor %}
    </ol>

    <footer class="upcoming-foot">
      {% if upcomingCopy.footnote %}
      <p class="upcoming-note">{{ upcomingCopy.footnote }}</p>
      {% endif %}
      <p class="upcoming-more">
        <a class="hero-link hero-link--gold" href="/next/">All of them, in full <span class="arrow">&rarr;</span></a>
      </p>
    </footer>
  </div>
</section>
{% endif %}
