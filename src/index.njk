<section id="dinner" data-screen-label="07 Thirty-Three" style="position:relative; width:100%; min-height:100vh; overflow:hidden; background:#0D1322; display:flex; align-items:center; justify-content:center; box-sizing:border-box; padding:120px 32px;">

