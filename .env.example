# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# The invitation form needs all three. Without them the endpoint still
# validates input and returns a 502 telling the visitor to email instead,
# so it degrades safely rather than silently dropping requests.

# From the Resend dashboard (starts with re_)
RESEND_API_KEY=

# Must be an address on the domain verified in Resend.
# We verified the subdomain send.regsymp.com, not the apex, to avoid
# colliding with the Google Workspace MX and SPF records on regsymp.com.
RESEND_FROM=RegSymp <noreply@send.regsymp.com>

# Where invitation requests are delivered. Reply-To is set to the
# submitter, so replying from this inbox reaches them directly.
INVITATION_RECIPIENT=info@regsymp.com

# Optional. Defaults: PORT=3000, HOST=0.0.0.0
# PORT=3000
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Admin interface (/admin).
#
# One variable. Content, admin accounts and service credentials all live in
# Postgres, so there is no token to set, nothing to mount, and no setup link
# to expire. First boot migrates the existing content and accounts from the
# deployed checkout automatically.
# ---------------------------------------------------------------------------

# The only variable production requires. It cannot live in the database for
# the obvious reason. Without it the server uses a local content directory,
# which is fine locally and NOT durable in production.
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: require TLS to the database. Worth setting when the connection
# crosses a public network. Values: require | no-verify | disable (default).
# DATABASE_SSL=require

# The rest are managed at /admin/credentials and stored in app_secrets:
#   RESEND_API_KEY, RESEND_FROM, INVITATION_RECIPIENT, SESSION_SECRET
# A value set here is overridden by the database copy, so that changing a
# credential in the admin actually takes effect.

# Optional local-development fallback, used only when DATABASE_URL is unset.
# In production the owner account lives in the database like every other.
# Comma-separated `email:hash` pairs; generate each with: npm run admin:user
ADMIN_USERS=

# Where content is kept when there is no database. Defaults to /data if it
# exists, else ./.content
# CONTENT_DIR=/data
