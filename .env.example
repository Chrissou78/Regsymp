# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# The invitation form needs all three. Without them the endpoint still
# validates input and returns a 502 telling the visitor to email instead,
# so it degrades safely rather than silently dropping requests.

# From the Resend dashboard (starts with re_)
RESEND_API_KEY=

# Must be an address on the domain verified in Resend.
# We verified the subdomain send.regsymp.com, not the apex, to avoid
# colliding with the Google Workspace MX and SPF records on regsymp.com.
RESEND_FROM=RegSymp <noreply@send.regsymp.com>

# Where invitation requests are delivered. Reply-To is set to the
# submitter, so replying from this inbox reaches them directly.
INVITATION_RECIPIENT=info@regsymp.com

# Optional. Defaults: PORT=3000, HOST=0.0.0.0
# PORT=3000
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Admin interface (/admin).
# Leave ADMIN_USERS empty to disable the admin entirely — an unconfigured
# deploy then exposes no admin surface at all.
# ---------------------------------------------------------------------------

# Comma-separated `email:hash` pairs. Generate each with:
#   npm run admin:user
# Never wrap the value in quotes.
ADMIN_USERS=

# GitHub token used to commit content changes. Needs write access to
# CONTENT_REPO. A fine-grained personal access token with Contents: Read
# and write, scoped to that one repository, is enough.
GITHUB_TOKEN=

# Where content commits land. Must be the repo and branch the server
# deploys from, or edits will not go live.
CONTENT_REPO=OC-Labs/regsymp
CONTENT_BRANCH=prod

# Random string used to sign CSRF tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
