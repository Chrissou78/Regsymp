# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# The invitation form needs all three. Without them the endpoint still
# validates input and returns a 502 telling the visitor to email instead,
# so it degrades safely rather than silently dropping requests.

# From the Resend dashboard (starts with re_)
RESEND_API_KEY=

# Must be an address on the domain verified in Resend.
# We verified the subdomain send.regsymp.com, not the apex, to avoid
# colliding with the Google Workspace MX and SPF records on regsymp.com.
RESEND_FROM=RegSymp <noreply@send.regsymp.com>

# Where invitation requests are delivered. Reply-To is set to the
# submitter, so replying from this inbox reaches them directly.
INVITATION_RECIPIENT=info@regsymp.com

# Optional. Defaults: PORT=3000, HOST=0.0.0.0
# PORT=3000
# HOST=0.0.0.0
