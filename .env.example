# ---------------------------------------------------------------------------
# THIS FILE IS TRACKED BY GIT. Never put a real value in it.
#
# Copy it to .env and fill that in instead — .env is gitignored. A real Resend
# key and a real database password were once typed in here and committed;
# GitHub's push protection caught the key on its way to the public mirror, and
# both had to be rotated. `npm test` now fails if any value appears below.
#
# Every assignment here is deliberately empty. The example values live in the
# comments above them.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------- invitation email
# The invitation form needs all three. Without them the endpoint still
# validates input and returns a 502 telling the visitor to email instead, so it
# degrades safely rather than silently dropping requests.
#
# In production these are managed at /admin/credentials and stored in the
# database; a value set here is overridden by the database copy, so that
# changing a credential in the admin actually takes effect.

# From the Resend dashboard. Starts with re_
RESEND_API_KEY=

# Must be an address on the domain verified in Resend. We verified the
# subdomain send.regsymp.com rather than the apex, to avoid colliding with the
# Google Workspace MX and SPF records on regsymp.com.
#   RESEND_FROM=RegSymp <noreply@send.regsymp.com>
RESEND_FROM=

# Where invitation requests are delivered. Reply-To is set to the submitter,
# so replying from this inbox reaches them directly.
#   INVITATION_RECIPIENT=info@regsymp.com
INVITATION_RECIPIENT=

# --------------------------------------------------------------------- storage
# The only variable production requires. It cannot live in the database for the
# obvious reason: reading the database needs it. Either a host-injected
# variable or a .env file works, and a host variable wins.
#
# Without it the server uses a local content directory, which is fine for a
# checkout and NOT durable in production — the admin says so above the
# collections when that is the case.
#   DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=

# Optional: require TLS to the database. Worth setting when the connection
# crosses a public network. Values: require | no-verify | disable (default).
#   DATABASE_SSL=require
DATABASE_SSL=

# Where content is kept when there is no database. Defaults to /data if it
# exists, else ./.content
#   CONTENT_DIR=/data
CONTENT_DIR=

# ------------------------------------------------------------------------ IPFS
# Photos are pinned to IPFS and the CID recorded in the database. The JWT alone
# is enough; the key and secret pair is only for accounts still on v2 auth.
# Managed at /admin/credentials in production.

# Pinata API Key JWT. Pinata shows it once, at creation.
PINATA_JWT=

# Legacy v2 credentials. Usually unnecessary.
PINATA_API_KEY=
PINATA_API_SECRET=

# Your dedicated gateway host, with no scheme and no trailing slash. The
# public ipfs.io gateway is rate-limited, so this is worth setting.
#   PINATA_GATEWAY=something.mypinata.cloud
PINATA_GATEWAY=

# ---------------------------------------------------------------------- admin
# Accounts live in the database. On a fresh installation with none,
# /admin/first-run creates the first one and makes it the owner, then stops
# existing.
#
# ADMIN_USERS is a local-development fallback only, used when DATABASE_URL is
# unset, and it takes `email:hash` PAIRS — bare addresses do nothing. Generate
# each with: npm run admin:user
#   ADMIN_USERS=someone@example.com:scrypt$aabb...$ccdd...
ADMIN_USERS=

# Signs CSRF tokens. Generated on first boot and stored in the database, so it
# normally needs no configuration. Set it only to pin the value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --------------------------------------------------------------------- serving
# Optional. Defaults: PORT=3000, HOST=0.0.0.0
#   PORT=3000
#   HOST=0.0.0.0
PORT=
HOST=
