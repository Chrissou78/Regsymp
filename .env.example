# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# The invitation form needs all three. Without them the endpoint still
# validates input and returns a 502 telling the visitor to email instead,
# so it degrades safely rather than silently dropping requests.

# From the Resend dashboard (starts with re_)
RESEND_API_KEY=

# Must be an address on the domain verified in Resend.
# We verified the subdomain send.regsymp.com, not the apex, to avoid
# colliding with the Google Workspace MX and SPF records on regsymp.com.
RESEND_FROM=RegSymp <noreply@send.regsymp.com>

# Where invitation requests are delivered. Reply-To is set to the
# submitter, so replying from this inbox reaches them directly.
INVITATION_RECIPIENT=info@regsymp.com

# Optional. Defaults: PORT=3000, HOST=0.0.0.0
# PORT=3000
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Admin interface (/admin).
#
# It needs no secrets. Content lives on a persistent volume, so there is no
# token to set and no setup link to expire. Mount a volume at /data and the
# admin works; the first visit to /admin creates the first account.
# ---------------------------------------------------------------------------

# Where editable content and admin accounts are kept. This MUST be a
# persistent volume in production. Defaults to /data when that exists, and
# to ./.content otherwise — which is fine locally and silently loses
# everything on redeploy in production. Verify with:
#   curl -s https://regsymp.com/api/health | jq .content.durable
# CONTENT_DIR=/data

# Optional recovery account, for signing in if the accounts file is ever
# damaged. Comma-separated `email:hash` pairs; generate each with:
#   npm run admin:user
# Never wrap the value in quotes.
ADMIN_USERS=

# Optional. Generated on first boot and kept on the volume if unset, so it
# normally needs no configuration. Set it to pin the value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# No longer used for saving. Only needed to read the old content repository,
# for an export or a one-off migration (/api/health?github=1).
# GITHUB_TOKEN=
# CONTENT_REPO=OC-Labs/regsymp
# CONTENT_BRANCH=prod
